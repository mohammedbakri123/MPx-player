<!-- FileProvider paths for diagnostics sharing and the #414 update
     APK: only the diagnostics subfolder and the updates folder of
     the app cache directory are ever shared. -->
<paths>
    <cache-path name="diagnostics" path="diagnostics/" />
    <!-- Issue #414: downloaded update APKs live here until installed. -->
    <cache-path name="updates" path="updates/" />
</paths>
