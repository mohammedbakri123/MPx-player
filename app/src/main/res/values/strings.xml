    <string name="dialog_privacy_title">Privacy &amp; Security</string>
    <string name="privacy_sec1_title">100% On-Device Architecture</string>
    <string name="privacy_sec1_body">MPx Player is an offline-first media player. Media indexing, metadata extraction, and playback happen exclusively on your device. Your file library is never uploaded to any remote server.</string>
    <string name="privacy_sec2_title">Zero Telemetry &amp; No Analytics</string>
    <string name="privacy_sec2_body">No tracking SDKs, no advertising identifiers, and no user surveillance frameworks are embedded in MPx Player. Your playback habits and files remain strictly your own.</string>
    <string name="privacy_sec3_title">Local SQLite Sandbox</string>
    <string name="privacy_sec3_body">Favourites, custom playlists, and playback resume points are stored in a private Room SQLite database (mpx_player.db) inside the Android protected application sandbox.</string>
    <string name="privacy_sec4_title">Transparent Permissions</string>
    <string name="privacy_sec4_body">• READ_MEDIA_VIDEO / AUDIO: Discovering local media files.\n• INTERNET: Optional, used solely when you paste a stream URL in Network Stream.</string>

    <string name="dialog_help_title">Help &amp; Player Guide</string>
    <string name="help_sec1_title">Player Gestures</string>
    <string name="help_sec1_body">• Double-tap left side: Seek back 10 seconds\n• Double-tap right side: Seek forward 10 seconds\n• Horizontal drag: Smooth precision scrub through video\n• Lock button: Prevent accidental touches while watching\n• Aspect ratio: Cycle through Fit, Stretch, 16:9, and Original</string>
    <string name="help_sec2_title">Audio &amp; Subtitle Tracks</string>
    <string name="help_sec2_body">• Audio Icon: Switch between discrete audio tracks (dual-audio, commentary)\n• Subtitle Icon: Select embedded or sidecar .vtt / .srt subtitle tracks\n• Subtitle Size: Configurable under Settings (Small, Normal, Large)</string>
    <string name="help_sec3_title">Device Diagnostics (Live)</string>
    <string name="help_diag_app">App: MPx Player 0.1.0-beta (Build 2)</string>
    <string name="help_diag_os">Android OS: SDK %1$d (%2$s)</string>
    <string name="help_diag_device">Device: %1$s %2$s</string>
    <string name="help_diag_engine">Engine: AndroidX Media3 ExoPlayer 1.3.1</string>
    <string name="help_diag_db">Database: Room SQLite (mpx_player.db)</string>

    <string name="dialog_legal_title">Legal &amp; Open Source</string>
    <string name="legal_sec1_title">Open Source Licenses</string>
    <string name="legal_sec1_body">• AndroidX Media3 ExoPlayer: Apache License 2.0\n• Jetpack Compose &amp; Material 3: Apache License 2.0\n• AndroidX Room Persistence Library: Apache License 2.0\n• Kotlin Coroutines: Apache License 2.0</string>
    <string name="legal_sec2_title">Inspiration Attribution Notice</string>
    <string name="legal_sec2_body">MPx Player is an independent, clean-room native Android media player. Its organization and UX workflow are inspired by MX Player (per reverse-engineered layout specifications). All code, views, and styling are rewritten 100% from scratch in native Kotlin and Jetpack Compose. No proprietary assets, code, or trademarks are incorporated.</string>
    <string name="legal_sec3_title">Terms of Use</string>
    <string name="legal_sec3_body">MPx Player is provided \'as is\' without warranty under the Apache 2.0 License. Users are responsible for their own media files.</string>

    <string name="dialog_about_body1">Pure native Kotlin rewrite with Jetpack Compose, AndroidX Media3 ExoPlayer, and Room SQLite persistence.</string>
    <string name="dialog_about_body2">High-density, utility-first media management without cloud dependence, tracking, or ads.</string>

    <string name="equalizer_dialog_msg">System Equalizer: No audio effect control panel (e.g. MusicFX or system equalizer app) was found on this device. Audio uses standard flat output.</string>

    <string name="issue32_dialog_header">%s (Issue 32)</string>
    <string name="issue32_status_notice">This feature is scheduled for Issue 32.</string>
    <string name="issue32_status_honest">Status: Honest placeholder — not faked.</string>
    <string name="issue32_status_detail">WhatsApp Status Saver requires scoped storage directory access. It will scan and save downloaded video and image statuses once built.</string>
    <string name="issue32_private_detail">Private Folder requires an encrypted SQLite or file vault protected by a PIN or biometric auth to hide sensitive media.</string>
    <string name="issue32_manager_detail">Media Manager &amp; Storage Cleaner will analyze device storage, identify duplicate videos, large files, and temporary cache.</string>
    <string name="issue32_bin_detail">Recycle Bin will preserve deleted files in an app-managed holding directory for 30 days before permanent deletion.</string>

