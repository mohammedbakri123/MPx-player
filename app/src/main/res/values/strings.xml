    <!-- Beta & About Screen -->
    <string name="about_beta_screen_title">About &amp; Beta Status</string>
    <string name="about_beta_badge">BETA RELEASE</string>
    <string name="about_beta_tagline">Native Kotlin media player for Android with Media3 ExoPlayer and Room persistence.</string>
    <string name="about_beta_build_info">Build 2 (VersionCode 2) • Branch: feature/beta-readiness</string>

    <!-- What is Ready in Beta -->
    <string name="about_beta_section_ready">WHAT IS READY IN BETA</string>
    <string name="about_beta_ready_subtitle">Core offline playback and library features are fully functional native implementations:</string>
    <string name="about_beta_feat_player_title">Media3 Video Playback Engine</string>
    <string name="about_beta_feat_player_desc">Hardware (HW/HW+) and Software (SW) decoding via AndroidX Media3 ExoPlayer. Video gestures (double-tap 10s seek, horizontal drag scrub), aspect ratio controls (Fit/Stretch/16:9/Original), embedded and external subtitles (.srt, .vtt), and multi-audio track switching.</string>
    <string name="about_beta_feat_bg_pip_title">Background Play &amp; Pop-up Play (PiP)</string>
    <string name="about_beta_feat_bg_pip_desc">Picture-in-Picture floating mode with custom window controls on Android 8.0+. Real background audio playback for videos and music via foreground service.</string>
    <string name="about_beta_feat_music_title">Music Player &amp; Audio Library</string>
    <string name="about_beta_feat_music_desc">Full MediaStore scanning for local tracks, albums, artists, and audio folders. Shuffle playback, track queue, and persistent MiniPlayer across all main tabs.</string>
    <string name="about_beta_feat_persistence_title">On-Device Room SQLite Persistence</string>
    <string name="about_beta_feat_persistence_desc">Custom playlists, starred favourites, and playback history with precise resume timestamps saved locally in mpx_player.db.</string>
    <string name="about_beta_feat_themes_title">Themes &amp; True Dark Mode</string>
    <string name="about_beta_feat_themes_desc">Four themes: Midnight OLED (#000000 cinema black), Dark Slate, Classic Navy, and Light Cinema. Immediate runtime theme application.</string>
    <string name="about_beta_feat_i18n_title">Full English &amp; Modern Standard Arabic (RTL)</string>
    <string name="about_beta_feat_i18n_desc">Bidirectional interface with full Right-to-Left (RTL) mirroring, mirrored icons, and instant language switching without app restarts.</string>

    <!-- What is Placeholder -->
    <string name="about_beta_section_placeholders">WHAT IS STILL PLACEHOLDER</string>
    <string name="about_beta_placeholders_subtitle">In accordance with our honest development principles, the following features are non-functional UI placeholders with no simulated or faked operations:</string>
    <string name="about_beta_holder_downloader_title">URL Downloader (Transfer tab)</string>
    <string name="about_beta_holder_downloader_desc">Status: UI shell only. No fake downloads or artificial progress bars. Real background download engine will be integrated in Phase 5.</string>
    <string name="about_beta_holder_transfer_title">Direct File Transfer (Transfer tab)</string>
    <string name="about_beta_holder_transfer_desc">Status: UI placeholder. Offline peer-to-peer (P2P / Wi-Fi Direct) file sharing protocol will connect in Phase 5.</string>
    <string name="about_beta_holder_status_title">Status Saver (Me tools grid)</string>
    <string name="about_beta_holder_status_desc">Status: Honest placeholder (Issue 32). WhatsApp status directory scanning and saving will connect when scoped storage directory permission flow is implemented.</string>
    <string name="about_beta_holder_private_title">Private Folder (Me tools grid)</string>
    <string name="about_beta_holder_private_desc">Status: Honest placeholder (Issue 32). Encrypted media vault with biometric / PIN authentication is scheduled for Issue 32.</string>
    <string name="about_beta_holder_manager_title">Media Manager &amp; Storage Cleaner (Me tools grid)</string>
    <string name="about_beta_holder_manager_desc">Status: Honest placeholder (Issue 32). Duplicate media detection, large file identification, and cache analyzer are scheduled for Issue 32.</string>
    <string name="about_beta_holder_bin_title">Recycle Bin (Me tools grid)</string>
    <string name="about_beta_holder_bin_desc">Status: Honest placeholder (Issue 32). App-managed temporary holding directory for deleted files (30-day retention) is scheduled for Issue 32.</string>

    <!-- Privacy & Integrity -->
    <string name="about_beta_section_privacy">PRIVACY &amp; TELEMETRY INTEGRITY</string>
    <string name="about_beta_privacy_body">MPx Player contains NO fake crash reporting, NO third-party telemetry, NO ad frameworks, and NO tracking SDKs. Your media playback history, favourites, and settings are strictly private and never leave your device.</string>

