<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV Leanback launcher banner (320x180dp, 16:9).
     Uses MPx true-black surface, identity-blue accent bar, and the app's
     own launcher foreground icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <gradient
                android:angle="135"
                android:startColor="#FF05070B"
                android:centerColor="#FF000000"
                android:endColor="#FF0B1628"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:height="4dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="#FF3B82F6" />
        </shape>
    </item>
    <item
        android:width="144dp"
        android:height="144dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
